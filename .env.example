# =====================================================================
# Glow by Adri — variables de entorno
# Copia este archivo como ".env" y completa los valores. Nunca subas ".env" a Git.
# =====================================================================

# --- Base de datos (PostgreSQL en Neon o Supabase) ---------------------
# URL "pooled" para la aplicación (en Neon: la que tiene "-pooler" en el host).
DATABASE_URL="postgresql://usuario:clave@host-pooler.region.aws.neon.tech/glow?sslmode=require"
# OPCIONAL: URL directa (sin pooler). Solo la usa el build de Vercel para aplicar migraciones;
# si no está, usa DATABASE_URL_UNPOOLED (la crea Neon al conectarlo en Vercel) o DATABASE_URL.
DIRECT_URL="postgresql://usuario:clave@host.region.aws.neon.tech/glow?sslmode=require"

# --- Sitio ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp del negocio (formato 57XXXXXXXXXX). Se usa mientras no exista la configuración en la BD.
NEXT_PUBLIC_WHATSAPP="573000000000"

# --- Autenticación (Auth.js, Fase 2) ----------------------------------
# Genera uno con:  npx auth secret   (o)   openssl rand -base64 32
AUTH_SECRET=""

# --- Usuaria administradora creada por el seed ------------------------
ADMIN_EMAIL="admin@glowbyadri.com"
# Contraseña temporal: cámbiala después del primer ingreso.
ADMIN_PASSWORD="CambiaEstaClave123!"

# --- Datos iniciales de la tienda para el seed (opcionales) ----------
SEED_TIENDA_DIRECCION="[DIRECCIÓN DE LA TIENDA], Popayán, Cauca"
SEED_TIENDA_HORARIO="[HORARIO DE ATENCIÓN]"
SEED_TIENDA_INSTAGRAM="glowbyadri"

# --- Cloudinary (imágenes de productos y banners) ---------------------
# Panel de Cloudinary → Settings → API Keys. La subida es FIRMADA por el servidor:
# el secreto nunca llega al navegador y solo una ADMIN puede subir imágenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Wompi (pagos en línea) — empieza con las llaves de PRUEBA -------
# comercios.wompi.co → Desarrolladores. Mientras tengan "xxxx", el pago en línea queda oculto
# y la tienda funciona con contra entrega y WhatsApp.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxx"
WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxxxxxxxxxx"
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxx"
# Pruebas: https://sandbox.wompi.co/v1   ·   Producción: https://production.wompi.co/v1
WOMPI_API_URL="https://sandbox.wompi.co/v1"

# --- Lector de facturas con IA (botón "Escanear factura") ------------
# Llave de la API de Anthropic (Claude): https://console.anthropic.com → API Keys.
# Sin ella, el botón muestra cómo configurarlo y se puede registrar la compra a mano.
# Costo aproximado: unos pocos centavos de dólar por factura.
ANTHROPIC_API_KEY=""

# --- WhatsApp Business Cloud API (FUTURO, todavía no se usa) ---------
# Hoy los mensajes salen con enlaces wa.me. El código ya está preparado en
# src/features/whatsapp/servicio.ts para conectar la API oficial de Meta.
WHATSAPP_USAR_API="false"
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
